DROP TEMPORARY TABLE IF EXISTS demo_expected_contacts;
CREATE TEMPORARY TABLE demo_expected_contacts (
  id bigint NOT NULL PRIMARY KEY,
  name varchar(30) COLLATE utf8mb4_unicode_ci NOT NULL,

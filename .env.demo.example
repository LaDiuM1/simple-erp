# /opt/simple-erp-demo/.env.demo 로 복사하고 chmod 600을 적용한다.
# DEMO_DB_ROOT_PASSWORD는 여기에 두지 않는다. ops/systemd/reset.env.example을
# /etc/simple-erp-demo/reset.env로 설치해 host reset service만 읽게 한다.

# demo app DB user(simple_erp_app) — backend에는 이 비밀번호만 전달된다.
DB_NAME=simple_erp_demo
DB_PASSWORD=
# DB transaction isolation is not operator-configurable here. compose.demo.yml
# pins TRANSACTION_READ_COMMITTED so serialized quota reads observe the latest commit.

# demo-only application secrets/accounts
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://demo.example.com
APP_ADMIN_LOGIN_ID=demo.operator
APP_ADMIN_PASSWORD=

# public demo resource/cost envelope
# Upload quota is durable for the current reset generation. Download byte limits
# are per rolling window and complement request-count/concurrency limits.
DEMO_UPLOAD_ACCOUNT_QUOTA_BYTES=268435456
DEMO_UPLOAD_ACCOUNT_QUOTA_FILES=16
DEMO_UPLOAD_GENERATION_QUOTA_BYTES=536870912
DEMO_UPLOAD_GENERATION_QUOTA_FILES=32
DEMO_UPLOAD_MIN_FREE_BYTES=5368709120
DEMO_UPLOAD_MIN_FREE_RATIO=0.20
DEMO_MAX_CONCURRENT_TRANSFERS=2
DEMO_MAX_CONCURRENT_UPLOADS_PER_ACCOUNT=1
DEMO_MAX_CONCURRENT_DOWNLOADS_PER_ACCOUNT=2
DEMO_EXCEL_ACCOUNT_QUOTA_ROWS=500
DEMO_EXCEL_GENERATION_QUOTA_ROWS=1000
DEMO_EXCEL_EXPORT_MAX_ROWS=500
DEMO_LOGIN_GLOBAL_RATE_LIMIT=30
DEMO_RATE_LIMIT_WINDOW=PT1M
DEMO_INGRESS_RATE_LIMIT=300
DEMO_INGRESS_GLOBAL_RATE_LIMIT=600
DEMO_MAX_CONCURRENT_INGRESS=8
DEMO_WRITE_RATE_LIMIT=60
DEMO_WRITE_GLOBAL_RATE_LIMIT=90
DEMO_MAX_CONCURRENT_WRITES=4
DEMO_READ_RATE_LIMIT=120
DEMO_READ_GLOBAL_RATE_LIMIT=180
DEMO_PREVIEW_RATE_LIMIT=20
DEMO_PREVIEW_GLOBAL_RATE_LIMIT=30
DEMO_MAX_CONCURRENT_READS=4
DEMO_MAX_CONCURRENT_PREVIEWS=2
DEMO_UPLOAD_RATE_LIMIT=10
DEMO_UPLOAD_GLOBAL_RATE_LIMIT=16
DEMO_EXCEL_UPLOAD_RATE_LIMIT=2
DEMO_EXCEL_UPLOAD_GLOBAL_RATE_LIMIT=2
DEMO_DOWNLOAD_RATE_LIMIT=20
DEMO_DOWNLOAD_GLOBAL_RATE_LIMIT=30
DEMO_DOWNLOAD_BYTE_RATE_WINDOW=PT1H
DEMO_DOWNLOAD_BYTE_RATE_LIMIT=67108864
DEMO_DOWNLOAD_GLOBAL_BYTE_RATE_LIMIT=100663296

# immutable seed/app compatibility contract
DEMO_SEED_EXPECTED_VERSION=2026.08.08.1
DEMO_COMPATIBLE_APP_VERSION=0.0.1-demo-schema-v3

# demo images — registry digest(name[:tag]@sha256:...) 또는 로컬 검증용 image ID(sha256:...)만 허용한다.
# digest 없는 sha-* / latest / 임의 tag는 reset 실행 시 거부한다.
BACKEND_IMAGE=
WEB_IMAGE=

# Caddy / local port binding
SITE_ADDRESS=demo.example.com
DEMO_HTTP_BIND=0.0.0.0
DEMO_HTTP_PORT=80
DEMO_HTTPS_BIND=0.0.0.0
DEMO_HTTPS_PORT=443

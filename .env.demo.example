# /opt/simple-erp-demo/.env.demo 로 복사하고 chmod 600을 적용한다.
# DEMO_DB_ROOT_PASSWORD는 여기에 두지 않는다. ops/systemd/reset.env.example을
# /etc/simple-erp-demo/reset.env로 설치해 host reset service만 읽게 한다.

# demo app DB user(simple_erp_app) — backend에는 이 비밀번호만 전달된다.
DB_NAME=simple_erp_demo
DB_PASSWORD=

# demo-only application secrets/accounts
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://demo.example.com
APP_ADMIN_LOGIN_ID=demo.operator
APP_ADMIN_PASSWORD=

# immutable seed/app compatibility contract
DEMO_SEED_EXPECTED_VERSION=2026.08.08.1
DEMO_COMPATIBLE_APP_VERSION=0.0.1-demo-schema-v3

# demo images — registry digest(name[:tag]@sha256:...) 또는 로컬 검증용 image ID(sha256:...)만 허용한다.
# digest 없는 sha-* / latest / 임의 tag는 reset 실행 시 거부한다.
BACKEND_IMAGE=
WEB_IMAGE=

# Caddy / local port binding
SITE_ADDRESS=demo.example.com
DEMO_HTTP_BIND=0.0.0.0
DEMO_HTTP_PORT=80
DEMO_HTTPS_BIND=0.0.0.0
DEMO_HTTPS_PORT=443
